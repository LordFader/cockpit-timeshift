msgstr "Fechar"

msgid "Enable at least one snapshot level."
msgstr "Ative pelo menos um nível de instantâneo."

msgid "Schedule enabled (timeshift checks hourly, snapshots when a level is due)."
msgstr "Agenda ativada (o timeshift verifica de hora em hora e cria instantâneos quando um nível está em devido)."

msgid "Timeshift native scheduling enabled."
msgstr "Agendamento nativo do Timeshift ativado."

msgid "Schedule disabled."
msgstr "Agenda desativada."

msgid "Schedule configuration failed."
msgstr "Falha ao configurar a agenda."

